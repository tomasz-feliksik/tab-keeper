{
  "manifest_version": 3,
  "name": "tab-keeper",
  "description": "Lets the local tab-keeper program list and arrange tabs in this profile. It cannot read pages.",
  "version": "0.1.0",
  "minimum_chrome_version": "121",
  "key": "",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "permissions": ["alarms", "bookmarks", "nativeMessaging", "storage", "tabGroups", "tabs"]
}

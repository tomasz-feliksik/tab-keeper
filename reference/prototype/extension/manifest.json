{
  "manifest_version": 3,
  "name": "chrome-tabs bridge",
  "description": "Lets the local chrome-tabs CLI list and unload tabs in this profile.",
  "version": "1.0.0",
  "minimum_chrome_version": "121",
  "key": "",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "alarms",
    "nativeMessaging",
    "storage",
    "tabs"
  ]
}
